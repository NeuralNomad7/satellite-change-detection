# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl

# Virtual environments
venv/
env/
.env
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/

# Linting / type-checking caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Data files (large, not tracked)
data/raw/*
data/processed/*
data/splits/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Model checkpoints (large, not tracked)
models/checkpoints/*
!models/checkpoints/.gitkeep

# Results (regenerated from code)
results/predictions/*
results/visualizations/*
results/metrics/*
!results/predictions/.gitkeep
!results/visualizations/.gitkeep
!results/metrics/.gitkeep

# Tensorboard logs
runs/
logs/

# OS files
.DS_Store
Thumbs.db

# Secrets
*.env
.env.*
credentials.json
